# Môi trường vận hành: local | staging | production
ENVIRONMENT=local

# Khóa bảo vệ endpoint đổi API Key (bắt buộc ở staging/production)
ADMIN_API_TOKEN=

# CORS origins (phân cách bởi dấu phẩy, mặc định * cho local)
CORS_ORIGINS=*

# Nhà cung cấp AI chính: gemini | openai
AI_PROVIDER=gemini

# Google Gemini API Key (khuyến nghị tiết kiệm chi phí ~80-120đ/bài)
GEMINI_API_KEY=
DEFAULT_VISION_MODEL=gemini-2.0-flash
DEFAULT_REASONING_MODEL=gemini-2.0-flash

# OpenAI API Key (tùy chọn thay thế)
OPENAI_API_KEY=
DEFAULT_OPENAI_MODEL=gpt-4o-mini

# Đường dẫn SQLite database (mặc định backend/data/edumark.db)
EDUMARK_DB_PATH=
